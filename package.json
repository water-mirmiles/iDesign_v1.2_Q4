{
  "name": "idesign-q4",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "node scripts/serve.mjs web",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "lint": "node scripts/check-source.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:sync": "node scripts/check-doc-sync.mjs",
    "check": "npm run lint && npm run docs:check && npm run build && npm run test:unit && npm run test:e2e",
    "package": "npm run check && python3 scripts/package-release.py"
  },
  "devDependencies": { "@playwright/test": "1.63.0" }
}
